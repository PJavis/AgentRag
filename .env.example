# =============================================================================
# AgentRag — Environment Configuration
# Sao chép file này thành .env và điền giá trị phù hợp.
# Xem README.md Section 5 để chọn cấu hình theo phần cứng.
# =============================================================================

# =============================================================================
# API KEYS — chỉ điền provider bạn dùng
# =============================================================================
OPENAI_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=
# DeepSeek (OpenAI-compatible). Heavy tasks route here via deepseek-* model names
# in LLM_TASK_MODEL_MAP (base_url https://api.deepseek.com). Falls back to OPENAI_API_KEY.
DEEPSEEK_API_KEY=

# HuggingFace Inference router endpoint (used when EMBEDDING/AGENT_PROVIDER=hf_inference)
HF_OPENAI_BASE_URL=https://router.huggingface.co/v1

# Ollama: native local (mặc định) hoặc container (docker compose --profile local-llm up -d)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1/
# OLLAMA_BASE_URL=http://ollama:11434/v1/    # ← dùng dòng này khi app chạy trong Docker cùng network
OLLAMA_API_KEY=ollama

# =============================================================================
# DATABASE & CACHE
# =============================================================================

# PostgreSQL — source of truth (port 5433 tránh conflict với local postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Elasticsearch — BM25 + kNN (agentrag_segments, agentrag_memory_doc, agentrag_memory_chat)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_NAME=agentrag_segments
ELASTICSEARCH_ENTITY_INDEX_NAME=agentrag_entities
ELASTICSEARCH_RELATIONSHIP_INDEX_NAME=agentrag_relationships

# Valkey — chat history cache + ARQ job queue + cost ledger stream + mindmap cache
REDIS_URL=redis://127.0.0.1:6379/0

# =============================================================================
# LLM PROVIDERS
# Providers: openai | gemini | hf_inference | ollama
# AGENT_* để trống → fallback về EXTRACTION_*
# =============================================================================

# Embedding — dùng cho search chunks và kNN.
# Default: local Ollama nomic-embed-text (768-dim, stable).
# bge-m3 (1024-dim, best VN): serve via TEI (`make serve-embed` → :8080) and set
#   EMBEDDING_PROVIDER=openai
#   EMBEDDING_MODEL=BAAI/bge-m3
#   EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1/
# NOTE: Ollama's bge-m3 GGUF can emit NaN at batch scale — prefer TEI for bge-m3.
# Changing the model changes the vector dim → delete + re-ingest the index.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=32

# Extraction — LLM chính: StructMem extraction, schema discovery, SQL compile
EXTRACTION_PROVIDER=ollama
EXTRACTION_MODEL=qwen2.5:14b-instruct
EXTRACTION_BASE_URL=
EXTRACTION_TEMPERATURE=0.0

# Agent runtime — override EXTRACTION nếu cần model mạnh hơn cho answer/synthesize
AGENT_PROVIDER=ollama
AGENT_MODEL=qwen2.5:14b-instruct
AGENT_BASE_URL=
AGENT_TEMPERATURE=0.5

# =============================================================================
# STRUCTMEM — Knowledge extraction pipeline
# Tất cả STRUCTMEM_* dùng chung prefix thay vì GRAPH_* cũ (không còn graph DB)
# =============================================================================

STRUCTMEM_ENABLED=true
# S5 domain tagging — SectionTagger inserts system_tag/specialty_tag on chunks
TAGGING_ENABLED=true
# S5 federated retrieval — DomainRouter + FederatedRetriever
DOMAIN_FILTER_ENABLED=true
DOMAIN_ROUTER_CONFIDENCE_THRESHOLD=0.7
DOMAIN_ROUTER_TOP_K=3
STRUCTMEM_INGEST_MODE=async               # sync: blocking | async: background worker

# Chunk size cho extraction (lớn hơn search chunk để ít episode hơn)
STRUCTMEM_CHUNK_MAX_TOKENS=1536
STRUCTMEM_CHUNK_OVERLAP_TOKENS=128

# Số chunk extract song song trong cùng 1 document job
STRUCTMEM_MAX_CONCURRENCY=3
# Số document jobs 1 ARQ worker xử lý song song.
# Giữ =1 nếu dùng Ollama local để tránh GPU thrashing; tăng lên khi dùng cloud API.
STRUCTMEM_WORKER_MAX_JOBS=1
STRUCTMEM_CHUNK_TIMEOUT_SECONDS=300        # timeout per-chunk (giây)
STRUCTMEM_JOB_TIMEOUT_SECONDS=3600        # timeout toàn bộ ARQ job (phải >> CHUNK * MAX_CONCURRENCY)
STRUCTMEM_CHUNK_RETRIES=3

# Cache kết quả extraction tránh re-extract khi re-ingest cùng content
STRUCTMEM_ENABLE_CACHE=true
STRUCTMEM_CACHE_DIR=.cache/agentrag/extract

# ES index — single doc memory index (kind ∈ {entry, synthesis}); merged in R4.
STRUCTMEM_INDEX=agentrag_memory_doc

# Cross-chunk consolidation
STRUCTMEM_CONSOLIDATION_THRESHOLD=20      # số chunks tích luỹ trước khi trigger
STRUCTMEM_CONSOLIDATION_HISTORY_TOP_K=15  # top-K historical entries làm seed

# =============================================================================
# CHUNKING (search path)
# =============================================================================

SEARCH_CHUNK_MAX_TOKENS=512
SEARCH_CHUNK_OVERLAP_TOKENS=64
SEARCH_CHUNK_BY_PARAGRAPH=true            # tách ưu tiên theo \n\n trước khi đếm token

# Tokenizer đếm token (model name, tải offline qua tiktoken — không cần API)
CHUNK_TOKENIZER_MODEL=text-embedding-3-large

# =============================================================================
# RETRIEVAL & RERANKING
# =============================================================================

RETRIEVAL_TOP_K=10
RETRIEVAL_NUM_CANDIDATES=50
RETRIEVAL_RRF_K=60                        # hệ số RRF (60 là chuẩn học thuật)

# Reranking — tắt mặc định, bật nếu có đủ VRAM (local) hoặc budget (cloud)
RETRIEVAL_RERANK_ENABLED=false
RETRIEVAL_RERANK_TOP_N=20
# Backend:
#   local_cross_encoder — bge-reranker-v2-m3 trên CPU/GPU. FREE, không cần API.
#                          Khuyến nghị: nhanh hơn + rẻ hơn llm_chat. (mặc định)
#   llm_chat            — rank qua chat LLM bất kỳ (chậm).
RETRIEVAL_RERANK_BACKEND=local_cross_encoder   # llm_chat | local_cross_encoder
RETRIEVAL_RERANK_PROVIDER=                # để trống → fallback AGENT_* → EXTRACTION_* (chỉ llm_chat)
RETRIEVAL_RERANK_MODEL=dengcao/bge-reranker-v2-m3   # cross-encoder cho local_cross_encoder
RETRIEVAL_RERANK_BASE_URL=
RETRIEVAL_RERANK_TEMPERATURE=0.0

# =============================================================================
# AGENT & CHAT
# =============================================================================

AGENT_MAX_STEPS=2
AGENT_TOOL_TOP_K=8
AGENT_MAX_CONTEXT_CHUNKS=8                # legacy chunk-count cap (used when token budget = 0)
AGENT_MAX_CONTEXT_TOKENS=12000             # token-aware budget for packed context (0 = disable)
# Per-call output ceiling. 128K = let the model self-cap (it stops at
# natural end-of-answer). Reduce (e.g. 8192) for fast local Ollama.
AGENT_MAX_OUTPUT_TOKENS=8192
# Cap image-segment fraction in retrieval top_k (default 0.3 = 30%).
# Set 1.0 to disable; 0.0 to exclude images entirely.
RETRIEVAL_MAX_IMAGE_RATIO=0.3

# PDF OCR fallback (hybrid Tesseract + Vision LLM for scanned PDFs).
# Requires apt: tesseract-ocr tesseract-ocr-vie tesseract-ocr-eng
PDF_OCR_FALLBACK_ENABLED=true
PDF_OCR_LANG=vie+eng
PDF_OCR_MIN_TEXT_CHARS=50
PDF_OCR_DPI=300
PDF_OCR_VISION_FALLBACK=true
PDF_OCR_VISION_THRESHOLD=30

# PDF parser backend: hybrid (Tesseract+vision, default) | mineru
PDF_PARSER_BACKEND=hybrid
# MinerU CLI backend (auto-picks GPU when local engine selected).
#   pipeline | vlm-auto-engine (default, Vietnamese-safe) | hybrid-auto-engine | *-http-client
# vlm-auto-engine = Qwen2-VL, preserves Vietnamese diacritics natively.
# hybrid-auto-engine = faster but paddleocr 'latin' drops Vietnamese accents.
MINERU_BACKEND=vlm-auto-engine
MINERU_OUTPUT_DIR=.cache/agentrag/mineru
# Vietnamese uses Latin script → 'latin'. Allowed:
# ch | en | korean | japan | chinese_cht | latin | arabic | east_slavic | cyrillic | devanagari
MINERU_LANG=latin
# Legacy, ignored by new CLI (device chosen via backend).
MINERU_DEVICE=cuda
# Route PPTX → libreoffice PDF → MinerU
INGEST_USE_MINERU_FOR_PPTX=false
AGENT_LOST_IN_MIDDLE_REORDER=true         # best chunks at start + end, weak middle (Liu 2023)
CHAT_HISTORY_WINDOW=10
CHAT_REDIS_TTL_SECONDS=300

# Self-critique: extra LLM call audits draft for hallucination / sycophancy.
# Fires only when retrieval thin (top RRF < threshold). +1 LLM call/turn.
AGENT_SELF_CRITIQUE_ENABLED=false
AGENT_SELF_CRITIQUE_RRF_THRESHOLD=0.05

# Plan-then-execute: planner LLM decomposes multi-hop questions into sub-queries,
# parallel retrieve, then answer. Skipped for short questions (greetings/lookups).
AGENT_PLAN_THEN_EXECUTE_ENABLED=true
AGENT_PLAN_TRIGGER_MIN_CHARS=120
AGENT_PLAN_MAX_SUBQUERIES=4

# =============================================================================
# CHAT STRUCTMEM — bộ nhớ hội thoại semantic (thay thế sliding-window history)
# Yêu cầu ARQ worker đang chạy (arq src.agentrag.worker.settings.WorkerSettings)
# =============================================================================

CHAT_STRUCTMEM_ENABLED=true               # semantic chat memory (replaces sliding-window). false = raw last-N turns only
CHAT_MEMORY_INDEX=agentrag_memory_chat   # single index, kind ∈ {entry, synthesis}
CHAT_MEMORY_CONSOLIDATION_THRESHOLD=10   # số turns tích luỹ trước khi trigger consolidation
CHAT_MEMORY_TOP_K=8                      # số entries retrieve mỗi lượt

# =============================================================================
# STRUCTURED SQL REASONING
# Cần model ≥ 7B với JSON output tốt (qwen2.5 khuyến nghị)
# =============================================================================

STRUCTURED_REASONING_ENABLED=true
STRUCTURED_CLASSIFIER_METHOD=rule+llm     # rule | llm | rule+llm
STRUCTURED_MAX_CHUNKS_FOR_SCHEMA=10
STRUCTURED_MAX_CHUNKS_FOR_EXTRACT=20
STRUCTURED_SQL_MAX_RETRIES=2
STRUCTURED_CONFIDENCE_THRESHOLD=0.7

# =============================================================================
# LLM ROUTING — route task khác nhau sang model khác nhau (tối ưu chi phí)
# =============================================================================

LLM_ROUTING_ENABLED=false

# Large-context auto-routing — override khi prompt > threshold tokens.
# Inspired by open-notebook's provision_langchain_model.
# Bỏ trống = disabled. Examples: gemini-2.5-pro (1M ctx), qwen2.5:32b (128k).
LLM_LARGE_CONTEXT_MODEL=
LLM_LARGE_CONTEXT_THRESHOLD=100000
LLM_TASK_MODEL_MAP={"classify":"llama3.2:3b","decide":"llama3.2:3b","domain_router":"llama3.2:3b","followup":"llama3.2:3b","plan":"deepseek-v4-pro","schema_discovery":"deepseek-v4-pro","sql_compile":"deepseek-v4-pro","synthesize":"deepseek-v4-flash","answer":"deepseek-v4-flash","mindmap":"deepseek-v4-flash","summary":"deepseek-v4-flash"}
# Task keys: classify | decide | schema_discovery | sql_compile | synthesize | answer
# Ví dụ Tier 2 (8GB VRAM, Ollama):
# LLM_TASK_MODEL_MAP={"classify":"llama3.2:3b","decide":"llama3.2:3b","answer":"qwen2.5:7b-instruct"}
# Ví dụ Tier 3 (24GB VRAM, Ollama):
# LLM_TASK_MODEL_MAP={"classify":"llama3.2:3b","decide":"llama3.2:3b","schema_discovery":"qwen2.5:14b-instruct","sql_compile":"qwen2.5:14b-instruct","answer":"qwen2.5:32b-instruct"}
# Ví dụ Cloud (OpenAI):
# LLM_TASK_MODEL_MAP={"classify":"gpt-4o-mini","decide":"gpt-4o-mini","schema_discovery":"gpt-4o-mini","sql_compile":"gpt-4o-mini","answer":"gpt-4o"}
LLM_COST_TRACKING_ENABLED=false

# =============================================================================
# ARQ WORKER AUTO-SCALER (scaler.py)
# Chỉ có hiệu lực khi chạy: python scaler.py
# =============================================================================

SCALER_MIN_WORKERS=1                     # số worker tối thiểu luôn chạy
SCALER_MAX_WORKERS=4                     # số worker tối đa
SCALER_SCALE_UP_AT=5                     # +1 worker mỗi N jobs trong queue
SCALER_POLL_SECONDS=5                    # tần suất kiểm tra queue (giây)
SCALER_COOLDOWN_SECONDS=30              # thời gian chờ giữa 2 lần rescale

# =============================================================================
# EXCEL INGEST
# =============================================================================

EXCEL_INGEST_MODE=markdown                # markdown: chunk như text | sql: query trực tiếp

# =============================================================================
# PDF PARSER (page-aware citations)
# =============================================================================

# pymupdf: page-aware (recommended) — chunk có page_start/page_end
# markitdown: legacy — không có page info
PDF_PARSER_BACKEND=pymupdf

# =============================================================================
# VISION LLM (mô tả ảnh y tế trong PDF + ảnh standalone)
# =============================================================================

# Bỏ trống VISION_PROVIDER để skip image parsing (text-only ingestion)
#
# Cloud (recommended):
#   VISION_PROVIDER=openai
#   VISION_MODEL=gpt-4o                   # cần OPENAI_API_KEY
# hoặc:
#   VISION_PROVIDER=gemini
#   VISION_MODEL=gemini-1.5-flash         # cần GEMINI_API_KEY
#
# Local (Ollama, không tốn API):
#   make docker-up-llm && make vision-pull
#   VISION_PROVIDER=ollama
#   VISION_MODEL=llava:13b
#   VISION_BASE_URL=http://127.0.0.1:11434/v1/
# VISION_PROVIDER: openai | gemini | ollama (bỏ trống = skip image parsing)
# VISION_MODEL:    gpt-4o | gemini-1.5-flash | llava:13b
# VISION_BASE_URL: override endpoint (chủ yếu cho Ollama)
VISION_PROVIDER=
VISION_MODEL=
VISION_BASE_URL=
# Concurrency + RPM for vision_extract worker job (image-heavy PDFs).
# Gemini free 2.5-flash: 10 RPM. Paid tier: bump RPM to 1000.
# Local Ollama (llava): keep CONCURRENCY=1 to avoid GPU thrashing.
VISION_MAX_CONCURRENCY=4
VISION_MAX_RPM=10                         # 0 = disable RPM cap (still bounded by concurrency)
VISION_PER_IMAGE_RETRIES=3
VISION_FLUSH_BATCH_SIZE=10                # commit segments → PG+ES every N images for live progress
VISION_TIMEOUT_SECONDS=180                # llava local cold-start có thể > 60s
# sync: describe images inline during ingest (blocks pipeline).
# async: skip inline, queue ARQ vision_extract → text retrieval ready ngay.
VISION_INGEST_MODE=async
IMAGE_STORAGE_DIR=data/images
IMAGE_MIN_SIZE_BYTES=5000
# Persist original uploaded bytes (PDF/DOCX/XLSX/MD) so UI can re-download
# or open in native viewer. Empty = discard after ingest.
ORIGINALS_DIR=data/originals

# =============================================================================
# OPEN-NOTEBOOK ADAPTER (mount tại /on cho frontend Next.js)
# =============================================================================

# Bỏ trống = no auth. Frontend login bằng password này.
# Lưu ý: cũng dùng làm Bearer token cho /on/api/* — xem section AUTH bên dưới.
# OPEN_NOTEBOOK_PASSWORD=demo123          # đặt ở section AUTH bên dưới

ADAPTER_ADMIN_TOKEN=                      # token cho /admin reasoning panel (bỏ trống = disabled)
ADAPTER_VERSION=0.7.0                     # version trả về cho frontend bootstrap

# =============================================================================
# OBSERVABILITY
# =============================================================================

OBSERVABILITY_TRACE_ENABLED=true          # ghi timings_ms trong response /chat

# Langfuse LLM tracing — auto-traces mọi LLM call (agent/vision/reranker) qua
# langfuse.openai drop-in. Self-host: `docker compose --profile observability up -d`
# → mở http://localhost:3000, tạo project, copy keys vào đây.
# Cần `uv sync --extra observability`.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3002

# Arize Phoenix — local trace + eval UI alongside Langfuse. Self-host:
# `docker compose --profile observability up -d` → UI http://localhost:6006.
# Cần `uv sync --extra phoenix`.
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT=agentrag

# RAGAS answer-quality eval — 2 bước (RAGAS cần langchain cũ, không cùng venv
# với app được). Bước 1 dump rows (venv này), bước 2 chấm điểm (venv cô lập):
#   python scripts/eval/run_ragas.py <title> --limit 5
#   GEMINI_API_KEY=$GEMINI_API_KEY uv run --no-project \
#       --with "ragas>=0.2,<0.3" --with "langchain-openai<0.3" \
#       python scripts/eval/score_ragas.py data/eval/<title>_ragas_rows.json
# Judge model truyền qua CLI (--judge-model), mặc định gemini-2.5-flash.

QUERY_REWRITE_ENABLED=true     # turns on the rewriter (required for both HyDE and decompose)
QUERY_REWRITE_HYDE=true        # default already true
QUERY_REWRITE_DECOMPOSE=false  # enable for multi-hop queries (costs 1 extra LLM call)

# ── RAG enhancement (2026-06) — all default OFF, enable to A/B ──────────────
# WS1 Contextual Retrieval (re-ingest needed). Route CONTEXTUAL_RETRIEVAL_TASK
# to DeepSeek in LLM_TASK_MODEL_MAP for cheap doc-prefix-cached context-gen.
CONTEXTUAL_RETRIEVAL_ENABLED=false
CONTEXTUAL_RETRIEVAL_TASK=contextualize
CONTEXTUAL_MAX_DOC_CHARS=48000
# WS2 RAPTOR summary layer (re-ingest needed)
RAPTOR_ENABLED=false
RAPTOR_MAX_LEVELS=3
RAPTOR_MIN_LEAVES=8
RAPTOR_SUMMARY_TASK=raptor_summary
RAPTOR_SUMMARY_MAX_RATIO=0.4
# WS3 CRAG critique + multi-hop
CRAG_ENABLED=false
CRAG_MIN_HITS=1
AGENT_CRITIQUE_MAX_RETRIES=1
AGENT_MULTIHOP_ENABLED=false
# WS4 Adaptive fast-path routing
ADAPTIVE_ROUTING_ENABLED=false
ADAPTIVE_FASTPATH_MIN_CONFIDENCE=0.85
# WS5 Semantic retrieval cache
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.97
SEMANTIC_CACHE_TTL_SECONDS=120

# =============================================================================
# USER AUTH (JWT) + GOOGLE OAUTH — replaces the legacy shared password
# =============================================================================

AUTH_ENABLED=true
AUTH_ALLOW_SIGNUP=true
# Comma-separated emails auto-promoted on signup/login (no SQL needed)
ADMIN_EMAILS=
JWT_SECRET=                           # set to a long random string in prod
JWT_TTL_DAYS=7

# Auto-fallback model when AGENT_MODEL / EXTRACTION_MODEL is missing
# at runtime (e.g. finetuned qwen-agentrag not pulled). Leave blank to
# disable. Default = the base the project finetunes from.
LLM_FALLBACK_MODEL=qwen2.5:7b-instruct

# Optional: leave blank to hide the "Continue with Google" button
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/on/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Legacy shared password — kept as a Bearer token for backward compat (optional)
OPEN_NOTEBOOK_PASSWORD=

# =============================================================================
# RATE LIMIT & UPLOAD HARDENING
# =============================================================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN_DEFAULT=120         # per-user per-minute for chat/search
RATE_LIMIT_UPLOAD_PER_MIN=120          # per-user per-minute for uploads (bulk-friendly)
UPLOAD_MAX_BYTES=104857600             # 100 MB
UPLOAD_DEDUPE_BY_HASH=true             # skip re-ingestion of identical bytes

# =============================================================================
# UVICORN SCALING (for `gunicorn -k uvicorn.workers.UvicornWorker -w N`)
# =============================================================================

UVICORN_WORKERS=1                      # bump for load-balanced multi-process
                                       # Production stack:
                                       #   docker compose --profile app up -d --build
                                       #   docker compose --profile app --profile edge up -d  # +nginx
